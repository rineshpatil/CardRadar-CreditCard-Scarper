# Copy to .env and fill in. `npm run dev` reads .env on start (restart after changes).

# Email sign-in codes via Resend (https://resend.com/api-keys).
# Without a verified domain, the default sender only delivers to the email that owns the Resend account.
RESEND_API_KEY=
# Optional, once you verify a domain in Resend, e.g. CardRadar <login@yourdomain.com>
EMAIL_FROM=

# Google sign-in: OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Authorized JavaScript origins must include http://localhost:3000 and http://localhost
GOOGLE_CLIENT_ID=

# CardRadar AI: an OpenAI-compatible chat API key (default endpoint: NVIDIA, model moonshotai/kimi-k2.5)
LLM_API_KEY=
# LLM_URL=https://integrate.api.nvidia.com/v1/chat/completions
# LLM_MODEL=moonshotai/kimi-k2.5

# Signs login sessions. Required in production; locally a fixed dev value is used if empty.
SESSION_SECRET=
